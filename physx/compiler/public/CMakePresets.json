{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/../../build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "PHYSX_ROOT_DIR": "${sourceDir}/../..",
                "PX_OUTPUT_LIB_DIR": "${sourceDir}/../../build/${presetName}",
                "PX_OUTPUT_BIN_DIR": "${sourceDir}/../../build/${presetName}",
                "PX_GENERATE_STATIC_LIBRARIES": "TRUE",
                "PX_BUILDSNIPPETS": "FALSE",
                "PX_BUILDPVDRUNTIME": "FALSE",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-arm",
            "displayName": "Android ARM",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "android",
                "PX_OUTPUT_ARCH": "arm",
                "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_NATIVE_API_LEVEL": "24"
            }
        },
        {
            "name": "ios-arm",
            "displayName": "iOS ARM",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "ios",
                "PX_OUTPUT_ARCH": "arm",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux X64",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "linux",
                "PX_OUTPUT_ARCH": "x86",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux-arm",
            "displayName": "Linux ARM",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "linux",
                "PX_OUTPUT_ARCH": "arm",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "mac-arm",
            "displayName": "Mac ARM",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "mac",
                "PX_OUTPUT_ARCH": "arm",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "mac-x64",
            "displayName": "Mac X64",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "mac",
                "PX_OUTPUT_ARCH": "x86",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        },
        {
            "name": "windows-x64",
            "displayName": "Windows X64",
            "inherits": "base",
            "cacheVariables": {
                "TARGET_BUILD_PLATFORM": "windows",
                "PX_OUTPUT_ARCH": "x86",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android-arm",
            "configurePreset": "android-arm"
        },
        {
            "name": "ios-arm",
            "configurePreset": "ios-arm"
        },
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        },
        {
            "name": "linux-arm",
            "configurePreset": "linux-arm"
        },
        {
            "name": "mac-arm",
            "configurePreset": "mac-arm"
        },
        {
            "name": "mac-x64",
            "configurePreset": "mac-x64"
        },
        {
            "name": "windows-x64",
            "configurePreset": "windows-x64"
        }
    ]
}
